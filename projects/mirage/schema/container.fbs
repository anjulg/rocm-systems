/// OCI container definition types.
///
/// These tables describe everything the daemon needs to launch, configure,
/// and connect to an OCI container for a simulation session.  They are
/// runtime-agnostic — the daemon translates them to Docker, Podman, or
/// any other OCI-compatible runtime without the simulator ever knowing
/// which runtime is in use.

include "common.fbs";

namespace mirage.container;


/// A bind-mount from the host into the container.
///
/// Used to expose simulator libraries, configuration files, device nodes,
/// or shared-memory regions to the containerised workload.
table BindMount {
    /// Absolute path on the host.
    host_path: string (required);

    /// Absolute path inside the container where `host_path` is mounted.
    container_path: string (required);

    /// If true the mount is read-only inside the container.
    readonly: bool = true;
}

/// A file whose contents are generated at session-creation time and
/// injected into the container filesystem.
///
/// Unlike bind-mounts, injected files do not correspond to an existing
/// host path — the daemon writes `content` to a temp file and mounts it.
/// This is how simulator-generated configs, schemas, and stubs are
/// delivered to the container.
table InjectedFile {
    /// Absolute path inside the container where the file will appear.
    container_path: string (required);

    /// Raw file content.  For text files (JSON configs, FBS schemas)
    /// this is UTF-8 encoded.  For binary blobs use raw bytes.
    content: [ubyte] (required);

    /// If true the file is mounted read-only (default).
    readonly: bool = true;

    /// Optional human-readable label for debugging / dashboard display,
    /// e.g. "rocjitsu simulation config", "simulation_config.fbs schema".
    label: string;
}

/// A port mapping from container to host.
///
/// Maps to the OCI `-p host_port:container_port/protocol` flag.
/// If `host_port` is 0, the runtime picks an ephemeral port.
table PortMapping {
    /// Port number inside the container (required).
    container_port: uint16;

    /// Port number on the host.  0 means "let the runtime choose".
    host_port: uint16 = 0;

    /// Protocol: "tcp" (default) or "udp".
    protocol: string;

    /// Optional human-readable label, e.g. "metrics", "debug-server".
    label: string;
}

/// Full specification of the OCI container that should be launched
/// for a simulation session.
///
/// Returned by the simulator in a `CreateSessionReply`.  The daemon
/// hands this to the container runtime (Docker, Podman, or any
/// OCI-compatible runtime) without modification.
///
/// This keeps the simulator completely decoupled from the container
/// runtime implementation.
table ContainerDef {
    /// Fully-qualified container image reference,
    /// e.g. "ghcr.io/rocm/pytorch:latest".
    /// If empty, the daemon falls back to `SessionDef.image`.
    image: string;

    /// Environment variables to set inside the container.
    ///
    /// These are *merged* with any env vars the user provides in `ExecDef`;
    /// simulator env vars take precedence on conflict.
    ///
    /// Typical entries:
    ///   LD_PRELOAD        — simulator interposition library
    ///   HSA_OVERRIDE_GFX_VERSION — target GPU version string
    ///   <SIM>_CONFIG      — path to injected config inside container
    env: [SetEnv];

    /// Host paths to bind-mount into the container.
    ///
    /// Used for simulator shared libraries, device stubs, etc.
    mounts: [BindMount];

    /// Files generated by the simulator to inject into the container.
    ///
    /// Typical entries: simulation config JSON, FlatBuffers schema files,
    /// generated GPU topology, stub device nodes.
    injected_files: [InjectedFile];

    /// Optional entrypoint override.  If set, the container CMD is
    /// replaced with this command.  Most simulators leave this empty
    /// and rely on `LD_PRELOAD` interposition instead.
    entrypoint: [string];

    /// Optional working directory inside the container.
    working_dir: string;

    /// Ports to expose from the container.
    ///
    /// Each entry maps a container port to an optional host port.
    /// Used for simulator debug servers, metrics endpoints, or
    /// application-level services (e.g. vLLM serving endpoint).
    ports: [PortMapping];

    /// Whether the container needs `--privileged` or elevated caps.
    /// Simulators should avoid requiring this whenever possible.
    privileged: bool = false;

    /// Optional resource limits (CPU, memory) for the container,
    /// encoded as a JSON string for runtime-agnostic portability.
    /// e.g. '{"cpu": "4", "memory": "16Gi"}'
    resource_limits_json: string;
}
