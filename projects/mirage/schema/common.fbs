namespace mirage;


/// The family or vendor of a GPU implementation.
/// Used to tag GpuDefs so the daemon knows which simulator owns them.
enum GpuFamily : byte {
    Unknown,
    /// AMD CDNA architecture (data-center compute GPUs)
    AmdCdna,
    /// AMD RDNA architecture (consumer/workstation GPUs)
    AmdRdna,
    /// RISC-V based experimental accelerator
    RiscV,
}

/// Describes a specific GPU model that a simulator can emulate.
///
/// A GpuDef is returned by a simulator to advertise the GPU models it
/// supports.  The `name` is a human-readable identifier (e.g. "MI300X")
/// while `arch` carries the ISA target string used by compilers
/// (e.g. "gfx942").
table GpuDef {
    /// Human-readable name of the GPU, e.g. "MI300X", "MI325X"
    name: string;

    /// ISA / architecture target string used by the compiler toolchain,
    /// e.g. "gfx942", "gfx950", "rv64i".
    arch: string;

    /// The GPU family / vendor this definition belongs to.
    family: GpuFamily = Unknown;

    /// Optional free-form description for display in the dashboard.
    description: string;
}

enum SimulatorMode : byte {
    /// Functional mode models the hardware at a high level, where the simulator executes instructions without detailed timing.
    Functional,
    /// Clocked mode models the hardware at a high level, where the simulator advances in discrete time steps (e.g., per instruction or per event).
    Clocked,
    /// Cycle-accurate mode is the most detailed and slowest mode, where the simulator models every cycle of the hardware.
    CycleAccurate,
}

/// A profile is a named configuration of a simulator.
///
/// Profiles bind together a simulator, a GPU model, a simulation mode,
/// and the cluster shape (num_gpus × num_nodes).  The daemon resolves
/// profile names to these definitions when creating sessions.
table ProfileDef {
    /// unique name of this profile
    name: string (required);
    /// what simulator to use for this profile
    simulator : string (required);

    /// the mode to run the simulator in. This can be used to select between different levels of accuracy and performance trade-offs in the simulator.
    mode : SimulatorMode;

    /// gpu definition for this profile.
    gpu: string (required);

    /// the number of gpus per node
    num_gpus: uint32 = 1;

    /// the number of nodes
    num_nodes : uint32 = 1;
}


/// A key-value pair representing a single environment variable.
table SetEnv {
    key: string (required);
    value: string (required);
}


/// how did a run end?
table RunExit {
    run_id: string;
    exit_code: int;
}

/// a request to run a command
table ExecDef {
    /// the program to run
    command: string (required);
    
    /// arguments to the command, e.g. ["-c", "echo hello world"]
    args : [string];

    /// extra environment variables to set for this run
    env: [SetEnv];
}

enum Stream : byte {
    Stdin,
    Stdout,
    Stderr,
}

/// StreamData is used to send data from the server to the client. It contains a stream field that identifies the stream type (e.g., stdout, stderr) and a data field that contains the actual bytes of the stream output.
table StreamData {
    /// The stream field is used to identify the stream type (e.g., stdout, stderr) and can be used by the client to route the data appropriately.
    stream: Stream;
    /// the data field contains the actual bytes of the stream output. The client can read this data and process it according to the stream type.
    data: [ubyte] (required);
}


/// A request to execute a command inside an existing session.
///
/// The daemon resolves the session, looks up its simulator, and calls
/// `get_exec_run_def` to let the simulator inject any extra environment
/// variables or wrapper commands before the run is actually started.
table RunDef {
    /// the session to use for this execution
    session: string (required);



    /// what to run on the head
    exec: ExecDef (required);

    /// optional command to run on the workers.  If not set, the workers won't run any command.
    worker_exec: ExecDef;


}

table SessionDef {
    /// a unique name for this session
    name: string (required);

    /// the profile to use for this session
    profile: string (required);

    /// the container image to use for this session.
    /// should be fully qualified, e.g. "ghcr.io/username/image:tag"
    image: string;
}



table ClusterDef {
    name: string;
    
    head_adress: string;

    /// the session to use for this cluster
    head_exec : ExecDef;
    workers_adress: [string] ;

    worker_exec : ExecDef;
}


/// Health status of a session or component.
enum HealthStatus : byte {
    Unknown,
    Healthy,
    Unhealthy,
}


/// a picosecond accurate time stamp
struct Time {
    /// you need to add the picoseconds field to get the actual time
    seconds: uint64;
    /// additional picoseconds to add to the seconds field
    picoseconds: uint64;
}