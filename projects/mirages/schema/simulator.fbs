/// Simulator plugin interface — FlatBuffer data types.
///
/// This schema defines every data structure that flows between the mirages
/// daemon and a simulator plugin.  The actual *behaviour* (which methods a
/// simulator must implement) is specified in the companion Python Protocol
/// class `mirages.simulator.Simulator`.
///
/// Together, these two files form the **Simulator Contract**:
///
///   schema/simulator.fbs   — data definitions  (this file)
///   src/mirages/simulator.pyi  — method signatures
///
/// Third-party simulators register themselves as Python entry-points
/// under the group `mirages.simulators` and must satisfy both halves
/// of the contract.

include "common.fbs";

namespace mirages.simulator;


// ---------------------------------------------------------------------------
//  Simulator identity
// ---------------------------------------------------------------------------

/// Metadata that a simulator returns to identify itself to the daemon.
///
/// Returned by `Simulator.info()`.  The daemon uses this to populate the
/// dashboard's simulator list and to match profile.simulator names.
table SimulatorInfo {
    /// A unique machine-readable identifier for this simulator,
    /// e.g. "rocjitsu", "gem5-gpu", "timing-model-x".
    /// Must be stable across versions — profiles reference this name.
    name: string (required);

    /// SemVer version string, e.g. "0.4.1".
    version: string (required);

    /// Human-readable one-liner shown in the dashboard.
    description: string;

    /// The list of GPU models this simulator can emulate out of the box.
    /// Each entry should have a unique `GpuDef.name`.
    supported_gpus: [GpuDef] (required);

    /// Whether this simulator allows the user to design completely custom
    /// GPU topologies beyond the pre-defined `supported_gpus` list.
    /// When true, the dashboard will show a "Design Custom GPU" button.
    supports_custom_gpus: bool = false;

    /// The simulation modes this simulator supports.
    /// If empty, all modes defined in `SimulatorMode` are assumed supported.
    supported_modes: [SimulatorMode];
}


// ---------------------------------------------------------------------------
//  Custom GPU design
// ---------------------------------------------------------------------------

/// A user-designed custom GPU topology.
///
/// Simulators that set `SimulatorInfo.supports_custom_gpus = true` must
/// accept this type in `Simulator.set_custom_gpu()`.  The `topology_json`
/// field carries a simulator-specific topology description (e.g. rocjitsu's
/// hierarchical component tree) as a UTF-8 JSON string.
///
/// The simulator validates the JSON against its own schema, and if valid,
/// returns a `GpuDef` that the daemon can use in profiles going forward.
table CustomGpuDef {
    /// A human-readable name the user chose for this custom GPU,
    /// e.g. "my-cdna4-256cu".
    name: string (required);

    /// Simulator-specific topology description encoded as a JSON string.
    ///
    /// For rocjitsu this is the `topology` subtree of a simulation config
    /// (see experimental/rocjitsu/schemas/simulation_config.fbs).
    /// Other simulators define their own topology format.
    topology_json: string (required);

    /// Optional base GPU to derive from.  If set, the simulator should
    /// start with this GPU's defaults and override only the fields
    /// present in `topology_json`.
    base_gpu: string;
}


// ---------------------------------------------------------------------------
//  Container definition
// ---------------------------------------------------------------------------

/// A bind-mount from the host into the container.
///
/// Used to expose simulator libraries, configuration files, device nodes,
/// or shared-memory regions to the containerised workload.
table BindMount {
    /// Absolute path on the host.
    host_path: string (required);

    /// Absolute path inside the container where `host_path` is mounted.
    container_path: string (required);

    /// If true the mount is read-only inside the container.
    readonly: bool = true;
}

/// A file whose contents are generated at session-creation time and
/// injected into the container filesystem.
///
/// Unlike bind-mounts, injected files do not correspond to an existing
/// host path — the daemon writes `content` to a temp file and mounts it.
/// This is how simulator-generated configs, schemas, and stubs are
/// delivered to the container.
table InjectedFile {
    /// Absolute path inside the container where the file will appear.
    container_path: string (required);

    /// Raw file content.
    content: [ubyte] (required);

    /// If true the file is mounted read-only (default).
    readonly: bool = true;

    /// Optional human-readable label for debugging / dashboard display,
    /// e.g. "rocjitsu simulation config", "simulation_config.fbs schema".
    label: string;
}

/// A port mapping from container to host.
///
/// Maps to the OCI `-p host_port:container_port/protocol` flag.
/// If `host_port` is 0, the runtime picks an ephemeral port.
table PortMapping {
    /// Port number inside the container (required).
    container_port: uint16;

    /// Port number on the host.  0 means "let the runtime choose".
    host_port: uint16 = 0;

    /// Protocol: "tcp" (default) or "udp".
    protocol: string;

    /// Optional human-readable label, e.g. "metrics", "debug-server".
    label: string;
}

/// Full specification of the OCI container that should be launched
/// for a simulation session.
///
/// The daemon passes a `SessionDef` and `ProfileDef` to
/// `Simulator.create_session()`, which returns a `ContainerDef`.
/// The daemon then hands this to the container runtime (Docker, Podman,
/// or any OCI-compatible runtime) without modification.
///
/// This keeps the simulator completely decoupled from the container
/// runtime implementation.
table ContainerDef {
    /// Fully-qualified container image reference,
    /// e.g. "ghcr.io/rocm/pytorch:latest".
    /// If empty, the daemon falls back to `SessionDef.image`.
    image: string;

    /// Environment variables to set inside the container.
    ///
    /// These are *merged* with any env vars the user provides in `RunDef`;
    /// simulator env vars take precedence on conflict.
    ///
    /// Typical entries:
    ///   LD_PRELOAD        — simulator interposition library
    ///   HSA_OVERRIDE_GFX_VERSION — target GPU version string
    ///   <SIM>_CONFIG      — path to injected config inside container
    env: [SetEnv];

    /// Host paths to bind-mount into the container.
    ///
    /// Used for simulator shared libraries, device stubs, etc.
    mounts: [BindMount];

    /// Files generated by the simulator to inject into the container.
    ///
    /// Typical entries: simulation config JSON, FlatBuffers schema files,
    /// generated GPU topology, stub device nodes.
    injected_files: [InjectedFile];

    /// Optional entrypoint override.  If set, the container CMD is
    /// replaced with this command.  Most simulators leave this empty
    /// and rely on `LD_PRELOAD` interposition instead.
    entrypoint: [string];

    /// Optional working directory inside the container.
    working_dir: string;

    /// Ports to expose from the container.
    ///
    /// Each entry maps a container port to an optional host port.
    /// Used for simulator debug servers, metrics endpoints, or
    /// application-level services (e.g. vLLM serving endpoint).
    ports: [PortMapping];

    /// Whether the container needs `--privileged` or elevated caps.
    /// Simulators should avoid requiring this whenever possible.
    privileged: bool = false;

    /// Optional resource limits (CPU, memory) for the container,
    /// encoded as a JSON string for runtime-agnostic portability.
    /// e.g. '{"cpu": "4", "memory": "16Gi"}'
    resource_limits_json: string;
}


// ---------------------------------------------------------------------------
//  Session health & performance
// ---------------------------------------------------------------------------

/// Health status of a running simulation session.
///
/// Returned by `Simulator.session_health()`.  The daemon polls this
/// periodically and surfaces it in the dashboard.
table SessionHealth {
    /// The session this health report is for.
    session_id: string (required);

    /// Overall health status.  Simulators should return `Healthy` when
    /// the simulation engine is responsive and processing events.
    status: HealthStatus;

    /// Wall-clock uptime since the session was created.
    uptime: Time;

    /// If status is Unhealthy, a human-readable explanation.
    error_message: string;

    /// Optional structured diagnostics as a JSON string.
    /// Simulators can include whatever is useful for debugging
    /// (event queue depth, thread status, memory usage, etc.).
    diagnostics_json: string;
}

/// Performance counters for a running simulation session.
///
/// Returned by `Simulator.session_perf()`.  These metrics are displayed
/// in the dashboard's session detail view and can be used for auto-scaling
/// decisions in cluster mode.
table SessionPerf {
    /// The session this perf report is for.
    session_id: string (required);

    /// Simulated time elapsed inside the simulator.
    /// For cycle-accurate simulators this reflects simulated clock ticks
    /// converted to wall-clock equivalent.
    simulated_time: Time;

    /// Actual wall-clock time elapsed since session start.
    wall_time: Time;

    /// Total simulation ticks (engine-specific unit).
    /// For rocjitsu this is simdojo discrete-event ticks.
    ticks: uint64;

    /// Instructions per cycle (IPC) — a measure of how efficiently
    /// the simulated GPU is executing workloads.
    /// 0.0 if the simulator does not track IPC.
    ipc: float64;

    /// Ratio of simulated time to wall time.
    /// Values > 1.0 mean the simulator runs faster than real-time.
    /// 0.0 if not applicable.
    simulation_speed: float64;

    /// Number of active simulated wavefronts / threads / contexts.
    active_contexts: uint32;

    /// Optional additional metrics as a JSON string.
    /// Simulators can expose whatever counters they have.
    extra_json: string;
}
